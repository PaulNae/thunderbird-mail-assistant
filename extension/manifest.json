{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-assistant@paulnae.github.io",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "type": "module"
  },
  "icons": {
    "32": "icons/icon.svg"
  },
  "action": {
    "default_title": "__MSG_actionChatTitle__",
    "default_icon": "icons/icon.svg"
  },
  "compose_action": {
    "default_popup": "compose/popup.html",
    "default_title": "__MSG_actionComposeTitle__",
    "default_icon": "icons/icon.svg"
  },
  "message_display_action": {
    "default_popup": "display/popup.html",
    "default_title": "__MSG_actionDisplayTitle__",
    "default_icon": "icons/icon.svg"
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "compose",
    "messagesRead",
    "accountsRead",
    "storage"
  ]
}
