{
  "name": "thunderbird-mail-assistant",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:ext": "web-ext lint --source-dir dist",
    "test": "node --test \"test/**/*.test.ts\"",
    "host:install": "node host/install-macos.mjs",
    "start": "npm run build && web-ext run --config web-ext-config.mjs",
    "package": "npm run check && web-ext build --config web-ext-config.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm run lint:ext && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "web-ext": "^10.8.0"
  }
}
